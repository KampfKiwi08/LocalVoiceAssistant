{
  "audio": { "device_in": 1, "device_out": 10, "samplerate": 16000, "input_gain": 3.0 },
  "wake":  { "model": "hey_jarvis", "threshold": 0.35 },
"record": { "silence_threshold": 0.0005, "silence_seconds": 0.7, "max_seconds": 15, "start_timeout_seconds": 5, "min_speech_seconds": 0.25 },
  "stt":   { "model": "small.en", "beam_size": 1 },
  "llm":   { "model": "llama3.2:2b", "max_tokens": 120, "keep_alive": "60m", "system_prompt": "You are a voice assistant. Your answers are spoken out loud, so reply in one or two short sentences. Use plain words only: no lists, no markdown, no emojis, no special characters." },
  "tts":   { "voice_model": "en_US-lessac-medium.onnx" },
  "beep":  { "freq": 880, "duration": 0.25, "volume": 0.3 },
  "debug": { "timings": true}
}